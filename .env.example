# Database Configuration
# PostgreSQL connection settings
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password
DATABASE_NAME=mealbot
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Mailgun Configuration
# Email service credentials for sending pairing notifications
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=your_mailgun_domain
MAILGUN_SMTP_LOGIN=your_mailgun_smtp_login

# Auth0 Configuration
# JWT authentication settings
AUTH0_DOMAIN=mealbot.auth0.com
AUTH0_AUDIENCE=https://mealbot-2.herokuapp.com/
# AUTH0_ISSUER is optional and will default to https://{AUTH0_DOMAIN}/
# AUTH0_ISSUER=https://mealbot.auth0.com/

# Application Configuration
# Server settings
PORT=8080
ENVIRONMENT=dev
